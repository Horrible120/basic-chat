# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
AGENT_NAME=小深

# Router 用轻量模型 + 关闭思考；Worker 默认 Flash，复杂任务自动切 Pro
ROUTER_MODEL=deepseek-flash
WORKER_MODEL=deepseek-flash
WORKER_MODEL_HEAVY=deepseek-v4-pro
ROUTER_THINKING=disabled
WORKER_THINKING=enabled
REASONING_EFFORT=high

MAX_WORKERS=3
MAX_STEPS=8
AGENT_ALLOW_WRITE=true

# DeepSeek Harness 作为 Worker 执行后端（未安装 dsh 时自动回退到内置 Worker）
DSH_ENABLED=true
DSH_COMMAND=dsh
DSH_PROFILE=headless
DSH_PROVIDER=deepseek-official
DSH_TIMEOUT=1800
# 可选：当前 dsh headless 若支持额外参数，可在这里追加，例如 --permission-mode workspace-write
DSH_EXTRA_ARGS=
# DSH_HOME=
